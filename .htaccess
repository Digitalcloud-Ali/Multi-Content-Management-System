# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Protect sensitive files (basename match)
<FilesMatch "(?i)^(db_config|env)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(log|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If MultiCMS lives in a subdirectory, uncomment and set:
    # RewriteBase /your-subdir/

    # Block direct PHP under includes/
    RewriteRule ^includes/.*\.php$ - [F,L]

    # Block PHP execution in upload / image dirs
    RewriteRule ^(images|uploads)/.*\.(?i:php|phtml|phar|php\d+)$ - [F,L]

    # Existing files/dirs (administrator, themes, assets) — serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pretty permalinks → front controller
    RewriteRule ^(.*)$ index.php?mc_route=$1 [QSA,L]
</IfModule>

# Custom error pages (document root relative; adjust if using a subdirectory)
ErrorDocument 403 /themes/default/403.php
ErrorDocument 404 /themes/default/404.php
ErrorDocument 500 /themes/default/500.php
