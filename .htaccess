# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Protect sensitive files (basename match)
<FilesMatch "(?i)^(db_config|env)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(log|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Auto-set at install (InstallPath). Safe default for web-root installs:
    RewriteBase /

    # Block direct PHP under includes/
    RewriteRule ^includes/.*\.php$ - [F,L]

    # Block PHP execution in content uploads / assets
    RewriteRule ^content/(uploads|assets)/.*\.(?i:php|phtml|phar|php\d+)$ - [F,L]

    # Existing files/dirs — serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pretty permalinks → front controller
    RewriteRule ^(.*)$ index.php?mc_route=$1 [QSA,L]
</IfModule>

ErrorDocument 403 /content/themes/default/403.php
ErrorDocument 404 /content/themes/default/404.php
ErrorDocument 500 /content/themes/default/500.php
